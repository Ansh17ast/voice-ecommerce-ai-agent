# ==============================================================================
# Voice E-Commerce AI Agent - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# OmniDimension AI Voice Agent Integration
# ------------------------------------------------------------------------------
# Obtain your API Key and Agent ID from the OmniDimension platform dashboard
OMNIDIM_API_KEY=your_omnidim_api_key_here
OMNIDIM_AGENT_ID=your_agent_id_here

# ------------------------------------------------------------------------------
# Green API WhatsApp Integration
# ------------------------------------------------------------------------------
# Instance connection details from green-api.com console
GREEN_API_HOST=https://api.green-api.com
GREEN_API_ID_INSTANCE=your_green_api_instance_id_here
GREEN_API_TOKEN=your_green_api_token_here

# ------------------------------------------------------------------------------
# Safety & Trial Mode Configuration
# ------------------------------------------------------------------------------
# TRIAL_MODE: When set to 'true', ALL outgoing WhatsApp messages are safely
# redirected to TEST_WHATSAPP_NUMBER to prevent real customer/evaluator contacts.
# Set to 'false' only in production when ready to dispatch to actual callers.
TRIAL_MODE=true

# Recipient phone number (digits only, e.g. 15551234567) used as the safety destination
TEST_WHATSAPP_NUMBER=15551234567

# Developer testing Chat ID for the /test/whatsapp endpoint
DEV_RECIPIENT_CHAT_ID=15551234567@c.us

# Default customer phone number for outbound call dispatch testing (E.164 format)
DEFAULT_CUSTOMER_PHONE=+15551234567

# ------------------------------------------------------------------------------
# Sales Representative Contact Info (Attached to WhatsApp Messages)
# ------------------------------------------------------------------------------
MY_CONTACT_NAME=Alex
MY_CONTACT_PHONE=+1-555-123-4567

# ------------------------------------------------------------------------------
# Optional: n8n Automation Webhook Integration
# ------------------------------------------------------------------------------
# If routing WhatsApp messages through an external n8n workflow:
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n-instance.com/webhook/send-whatsapp
# N8N_WEBHOOK_HEADER_NAME=X-Auth-Token
# N8N_WEBHOOK_HEADER_VALUE=your_custom_header_value
# N8N_WEBHOOK_BEARER_TOKEN=your_bearer_token_here
